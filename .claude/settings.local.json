{
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(xargs:*)",
      "Bash(nvim:*)",
      "WebFetch(domain:neovim.io)",
      "Bash(xxd:*)",
      "Bash(python3:*)",
      "Bash(git status:*)",
      "WebFetch(domain:codeberg.org)",
      "Bash(make clean:*)",
      "Bash(make:*)",
      "Bash(brew install:*)",
      "WebFetch(domain:registry.npmjs.org)",
      "Bash(sudo chown:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  }
}
